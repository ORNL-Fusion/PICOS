// Input data:
// Model notes:
// - Purpose: generic baseline template for the original hybrid/guiding-center PICOS workflow.
// - Particles: 1D-2V guiding-center kinetic ions with fluid electron pressure in the field solve.
// - Field: SW_fieldSolveModel=0 uses the Ohm-law/hybrid electric-field model when SW_EfieldSolve=1.
// Field solver model legend:
// - 0 = Ohm-law hybrid, 1 = charge-density Poisson, 2 = reformulated Poisson stress-moment E-field update.
// =============================================================================
mpisForFields               2
quietStart                  1
numberOfParticleSpecies     1
numberOfTracerSpecies       0
advanceParticleMethod       1

// Characteristic values:
// =============================================================================
CV_ne                       5.0E19
CV_Te                       15
CV_B                        1.5
CV_Tpar                     15
CV_Tper                     15

// Simulation time:
// =============================================================================
DTc                         0.5
simulationTime              25000

// Switches:
// =============================================================================
SW_EfieldSolve               1
SW_fieldSolveModel           0
SW_BfieldSolve               0
SW_Collisions                1
SW_RFheating                 1
SW_RFheatingIons             1
SW_RFheatingElectrons        0
SW_relativisticElectrons     0
SW_advancePos                1
SW_linearSolve               0

// Magnetic field initial conditions:
// =============================================================================
IC_uniformBfield            0
IC_BX                       0.2
IC_BY                       0.0
IC_BZ                       0.0
IC_BX_NX                    200
IC_BX_fileName              MPEX_B_norm_PICOS_scenario_14.txt
IC_phiLeft                  0.0
IC_phiRight                 0.0
Poisson_BCModel             0
Poisson_sheathCoefficient   3.0
ReformulatedPoisson_lambda  -1.0
ReformulatedPoisson_quasiNeutral 0

// Geometry:
// =============================================================================
dp                          0.4243
r1                          0.0
r2                          0.05
LX_min                      -2
LX_max                      8

// Electron initial conditions:
// =============================================================================
IC_ne                       1.0E18
IC_Te                       15
IC_Te_NX                    200
IC_Te_fileName              ProtoMPEX_Te_norm_PICOS_c.txt

// Ion RF operator:
// =============================================================================
RF_ion_Prf                      50E3
RF_ion_n_harmonic               1
RF_ion_freq                     8.385E6
RF_ion_x1                       4.0
RF_ion_x2                       6.5
RF_ion_t_ON                     12000
RF_ion_t_OFF                    20000
RF_ion_kpar                     20
RF_ion_kper                     100
RF_ion_handedness               -1
RF_ion_EfieldMode               0
RF_ion_EfieldAmplitude          0.0
RF_ion_maxEnergyGainFraction    0.0
RF_ion_maxParticleEnergy        0.0
RF_ion_maxVelocityFractionC     0.0
RF_ion_Prf_fileName             Prf_profile.txt
RF_ion_Prf_NS                   200

// Electron RF/ECH operator:
// =============================================================================
RF_electron_Prf                      50E3
RF_electron_n_harmonic               1
RF_electron_freq                     8.385E6
RF_electron_x1                       4.0
RF_electron_x2                       6.5
RF_electron_t_ON                     12000
RF_electron_t_OFF                    20000
RF_electron_kpar                     20
RF_electron_kper                     100
RF_electron_handedness               -1
RF_electron_EfieldMode               0
RF_electron_EfieldAmplitude          0.0
RF_electron_maxEnergyGainFraction    0.0
RF_electron_maxParticleEnergy        0.0
RF_electron_maxVelocityFractionC     0.0
RF_electron_Prf_fileName             Prf_profile.txt
RF_electron_Prf_NS                   200

// Output variables:
// =============================================================================
outputCadence               500
outputs_variables           {X_p,V_p,a_p,BX_p,BX_m,n_m,Tpar_m,Tper_m,u_m,EX_m}

// Data smoothing:
// =============================================================================
smoothingParameter          1.0E-4
filtersPerIterationFields   2
filtersPerIterationIons     2
