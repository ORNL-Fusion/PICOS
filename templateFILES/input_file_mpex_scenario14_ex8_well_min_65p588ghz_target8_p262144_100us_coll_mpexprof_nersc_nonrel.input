RF_electron_maxEnergyGainFraction    2.5000000000000000e-01
RF_electron_maxParticleEnergy        5.0000000000000000e+03
RF_electron_maxVelocityFractionC     2.0000000000000001e-01
RF_electron_Prf_fileName             mpex_scenario14_ex8_well_min_65p588ghz_target8_p262144_100us_coll_mpexprof_nersc_nonrel_rf_power_norm.txt
RF_electron_Prf_NS                   200


// Output variables:
// =============================================================================
// outputCadence is in background ion gyroperiod units. This deck requests
// 50 output intervals plus the initial t=0 snapshot.
outputCadence               2.0860734119736904e+01
outputs_variables           {X_p,V_p,a_p,mu_p,BX_p,EX_p,BX_m,dBX_m,ddBX_m,n_m,Tpar_m,Tper_m,u_m,EX_m,Phi_m}

// Data smoothing:
// =============================================================================
smoothingParameter          1.0000000000000000e-03
filtersPerIterationFields   2
filtersPerIterationIons     2
